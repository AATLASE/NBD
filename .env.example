# Supabase : Project Settings > API (ou `npx supabase status` en local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application mono-utilisateur : seule cette adresse peut demander un lien de connexion.
# Laisser vide pour ne pas restreindre.
ALLOWED_EMAIL=

# En local uniquement : adresse de la boîte de test Supabase (http://127.0.0.1:54324).
# Ne pas définir en production, où les mails partent réellement.
LOCAL_MAILBOX_URL=

# Clé API Anthropic, côté serveur uniquement. Elle sert à proposer un programme de sport et un plan
# nutritif aux nouveaux comptes (et servira au chatbot). Sans elle, la proposition automatique est
# simplement indisponible : chacun construit son programme à la main.
ANTHROPIC_API_KEY=
