# Supabase : Project Settings > API (ou `npx supabase status` en local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Application mono-utilisateur : seule cette adresse peut demander un lien de connexion.
# Laisser vide pour ne pas restreindre.
ALLOWED_EMAIL=

# En local uniquement : adresse de la boîte de test Supabase (http://127.0.0.1:54324).
# Ne pas définir en production, où les mails partent réellement.
LOCAL_MAILBOX_URL=

# Clé API Anthropic, côté serveur uniquement. Elle sert à proposer un programme de sport et un plan
# nutritif aux nouveaux comptes (et servira au chatbot). Sans elle, la proposition automatique est
# simplement indisponible : chacun construit son programme à la main.
ANTHROPIC_API_KEY=

# Notifications (Web Push). Clés VAPID : node -e "console.log(require('web-push').generateVAPIDKeys())"
# À générer une seule fois : en changer désabonne tous les téléphones. VAPID_SUBJECT : une adresse
# de contact pour les services de notification (Google, Apple), sous la forme mailto:toi@exemple.fr.
# Lues au démarrage du serveur : pas besoin de reconstruire l'image pour les changer.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Clé secrète Supabase (Project Settings > API Keys, « sb_secret_… »), côté serveur uniquement.
# Elle ne sert qu'au rappel du matin des jours de séance, envoyé sans que personne soit connecté.
# Sans elle, les comptes rendus et les ajustements sont notifiés, mais pas les jours de séance.
SUPABASE_SECRET_KEY=
